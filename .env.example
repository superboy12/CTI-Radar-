# ===========================================
# Cyber Threat Intelligence Platform
# Environment Configuration
# ===========================================

# Application
APP_NAME=CyberThreatIntel
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://cti_user:cti_password@localhost:5432/cti_db
DATABASE_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# First Admin User (created on init)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@cti-platform.local
FIRST_ADMIN_PASSWORD=ChangeThisPassword123!

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ML
ML_MODELS_DIR=../ml/models
ML_DATASETS_DIR=../ml/datasets

# DNS Resolution
DNS_TIMEOUT=5
DNS_MAX_RETRIES=3

# Feature Extraction
FEATURE_EXTRACTION_TIMEOUT=10
FEATURE_EXTRACTION_USER_AGENT=CTI-Research-Bot/0.1

# Redis (optional, for future phases)
# REDIS_URL=redis://localhost:6379/0
